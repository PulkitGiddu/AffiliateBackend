-- Enable UUID extension if not already enabled
CREATE EXTENSION IF NOT EXISTS "uuid-ossp";

-- ================================================================
-- FUNCTION: update_timestamp
-- Reusable trigger function for automatic timestamp updates
-- ================================================================
CREATE OR REPLACE FUNCTION update_timestamp()
RETURNS TRIGGER AS $$
BEGIN
    NEW.updated_at = NOW();
    RETURN NEW;
END;
$$ LANGUAGE plpgsql;

-- ================================================================
-- TABLE: user_login
-- Stores user account information and referral system
-- ================================================================
CREATE TABLE IF NOT EXISTS user_login (
    id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
    email_id VARCHAR(255) UNIQUE NOT NULL,
    username VARCHAR(255) UNIQUE NOT NULL,
    first_name VARCHAR(255),
    last_name VARCHAR(255),
    password_hash VARCHAR(255) NOT NULL,
    is_active BOOLEAN NOT NULL DEFAULT true,
    referral_code VARCHAR(50) UNIQUE NOT NULL,
    referred_by_id UUID,
    profile_picture_url VARCHAR(2048),
    created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,
    CONSTRAINT fk_referred_by FOREIGN KEY (referred_by_id) REFERENCES user_login(id) ON DELETE SET NULL
);

CREATE TRIGGER set_user_login_timestamp
BEFORE UPDATE ON user_login
FOR EACH ROW EXECUTE FUNCTION update_timestamp();

CREATE INDEX IF NOT EXISTS idx_user_login_email ON user_login(email_id);
CREATE INDEX IF NOT EXISTS idx_user_login_username ON user_login(username);
CREATE INDEX IF NOT EXISTS idx_user_login_referral_code ON user_login(referral_code);

-- ================================================================
-- TABLE: merchants
-- Stores merchant/store information
-- ================================================================
CREATE TABLE IF NOT EXISTS merchants (
    id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
    name VARCHAR(255) NOT NULL,
    logo_url VARCHAR(2048),
    created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP
);

CREATE TRIGGER set_merchants_timestamp
BEFORE UPDATE ON merchants
FOR EACH ROW EXECUTE FUNCTION update_timestamp();

CREATE INDEX IF NOT EXISTS idx_merchants_name ON merchants(name);

-- ================================================================
-- TABLE: categories
-- Stores product categories with support for hierarchical structure
-- ================================================================
CREATE TABLE IF NOT EXISTS categories (
    id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
    name VARCHAR(255) NOT NULL,
    slug VARCHAR(255) UNIQUE NOT NULL,
    parent_id UUID,
    created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,
    CONSTRAINT fk_parent_category FOREIGN KEY (parent_id) REFERENCES categories(id) ON DELETE SET NULL
);

CREATE TRIGGER set_categories_timestamp
BEFORE UPDATE ON categories
FOR EACH ROW EXECUTE FUNCTION update_timestamp();

CREATE INDEX IF NOT EXISTS idx_categories_slug ON categories(slug);
CREATE INDEX IF NOT EXISTS idx_categories_parent_id ON categories(parent_id);

-- ================================================================
-- TABLE: products
-- Stores product information with pricing and merchant details
-- ================================================================
CREATE TABLE IF NOT EXISTS products (
    id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
    product_name VARCHAR(512) NOT NULL,
    description TEXT,
    product_unique_id VARCHAR(100) NOT NULL UNIQUE,
    original_price DECIMAL(10, 2),
    sale_price DECIMAL(10, 2) NOT NULL,
    review_score NUMERIC(3, 2),
    review_count INTEGER DEFAULT 0,
    affiliate_url TEXT NOT NULL,
    image_url TEXT,
    merchant_id UUID NOT NULL,
    category_id UUID NOT NULL,
    is_active BOOLEAN NOT NULL DEFAULT true,
    deals_expires_at TIMESTAMP WITH TIME ZONE,
    created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,
    CONSTRAINT fk_merchant FOREIGN KEY (merchant_id) REFERENCES merchants(id) ON DELETE RESTRICT,
    CONSTRAINT fk_category FOREIGN KEY (category_id) REFERENCES categories(id) ON DELETE RESTRICT,
    CONSTRAINT chk_price_positive CHECK (sale_price > 0)
);

CREATE TRIGGER set_products_timestamp
BEFORE UPDATE ON products
FOR EACH ROW EXECUTE FUNCTION update_timestamp();

CREATE INDEX IF NOT EXISTS idx_products_merchant_id ON products(merchant_id);
CREATE INDEX IF NOT EXISTS idx_products_category_id ON products(category_id);
CREATE INDEX IF NOT EXISTS idx_products_product_unique_id ON products(product_unique_id);
CREATE INDEX IF NOT EXISTS idx_products_is_active ON products(is_active);
CREATE INDEX IF NOT EXISTS idx_products_deals_expires ON products(deals_expires_at);

-- ================================================================
-- TABLE: sales_events
-- Stores promotional events and sales campaigns
-- ================================================================
CREATE TABLE IF NOT EXISTS sales_events (
    id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
    name VARCHAR(255) NOT NULL,
    description TEXT,
    start_date TIMESTAMP WITH TIME ZONE NOT NULL,
    end_date TIMESTAMP WITH TIME ZONE NOT NULL,
    banner_url VARCHAR(2048),
    merchant_id UUID,
    created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,
    CONSTRAINT fk_sales_merchant FOREIGN KEY (merchant_id) REFERENCES merchants(id) ON DELETE SET NULL,
    CONSTRAINT chk_date_order CHECK (start_date < end_date)
);

CREATE TRIGGER set_sales_events_timestamp
BEFORE UPDATE ON sales_events
FOR EACH ROW EXECUTE FUNCTION update_timestamp();

CREATE INDEX IF NOT EXISTS idx_sales_events_merchant_id ON sales_events(merchant_id);
CREATE INDEX IF NOT EXISTS idx_sales_events_start_date ON sales_events(start_date);
CREATE INDEX IF NOT EXISTS idx_sales_events_end_date ON sales_events(end_date);

-- ================================================================
-- TABLE: product_sales_events
-- Junction table linking products to sales events
-- ================================================================
CREATE TABLE IF NOT EXISTS product_sales_events (
    product_id UUID NOT NULL,
    sales_event_id UUID NOT NULL,
    PRIMARY KEY (product_id, sales_event_id),
    CONSTRAINT fk_product FOREIGN KEY (product_id) REFERENCES products(id) ON DELETE CASCADE,
    CONSTRAINT fk_sales_event FOREIGN KEY (sales_event_id) REFERENCES sales_events(id) ON DELETE CASCADE
);

CREATE INDEX IF NOT EXISTS idx_product_sales_events_product ON product_sales_events(product_id);
CREATE INDEX IF NOT EXISTS idx_product_sales_events_event ON product_sales_events(sales_event_id);

