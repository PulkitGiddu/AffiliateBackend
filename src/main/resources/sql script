-- ================================================================
-- SnatchMart PostgreSQL Schema
-- Compatible with PostgreSQL 12+
-- Run this script to create/ensure all tables match JPA entities.
-- ================================================================

-- Enable UUID extension
CREATE EXTENSION IF NOT EXISTS "uuid-ossp";

-- ================================================================
-- FUNCTION: update_timestamp
-- Sets updated_at to current time on row update (PG 11+: EXECUTE FUNCTION)
-- ================================================================
CREATE OR REPLACE FUNCTION update_timestamp()
RETURNS TRIGGER AS $$
BEGIN
    NEW.updated_at = CURRENT_TIMESTAMP;
    RETURN NEW;
END;
$$ LANGUAGE plpgsql;

-- ================================================================
-- TABLE: user_login
-- ================================================================
CREATE TABLE IF NOT EXISTS user_login (
    id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
    email_id VARCHAR(255) UNIQUE NOT NULL,
    username VARCHAR(255) UNIQUE NOT NULL,
    first_name VARCHAR(255),
    last_name VARCHAR(255),
    password_hash VARCHAR(255) NOT NULL,
    is_active BOOLEAN NOT NULL DEFAULT true,
    referral_code VARCHAR(50) UNIQUE NOT NULL,
    referred_by_id UUID,
    profile_picture_url VARCHAR(2048),
    created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,
    CONSTRAINT fk_referred_by FOREIGN KEY (referred_by_id) REFERENCES user_login(id) ON DELETE SET NULL
);

CREATE TRIGGER set_user_login_timestamp
BEFORE UPDATE ON user_login
FOR EACH ROW EXECUTE FUNCTION update_timestamp();

CREATE INDEX IF NOT EXISTS idx_user_login_email ON user_login(email_id);
CREATE INDEX IF NOT EXISTS idx_user_login_username ON user_login(username);
CREATE INDEX IF NOT EXISTS idx_user_login_referral_code ON user_login(referral_code);

-- ================================================================
-- TABLE: merchants
-- ================================================================
CREATE TABLE IF NOT EXISTS merchants (
    id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
    name VARCHAR(255) NOT NULL,
    logo_url VARCHAR(2048),
    created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP
);

CREATE TRIGGER set_merchants_timestamp
BEFORE UPDATE ON merchants
FOR EACH ROW EXECUTE FUNCTION update_timestamp();

CREATE INDEX IF NOT EXISTS idx_merchants_name ON merchants(name);

-- ================================================================
-- TABLE: categories
-- ================================================================
CREATE TABLE IF NOT EXISTS categories (
    id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
    name VARCHAR(255) NOT NULL,
    slug VARCHAR(255) UNIQUE NOT NULL,
    parent_id UUID,
    created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,
    CONSTRAINT fk_parent_category FOREIGN KEY (parent_id) REFERENCES categories(id) ON DELETE SET NULL
);

CREATE TRIGGER set_categories_timestamp
BEFORE UPDATE ON categories
FOR EACH ROW EXECUTE FUNCTION update_timestamp();

CREATE INDEX IF NOT EXISTS idx_categories_slug ON categories(slug);
CREATE INDEX IF NOT EXISTS idx_categories_parent_id ON categories(parent_id);

-- ================================================================
-- TABLE: products
-- ================================================================
CREATE TABLE IF NOT EXISTS products (
    id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
    product_name VARCHAR(512) NOT NULL,
    description TEXT,
    product_unique_id VARCHAR(100) NOT NULL UNIQUE,
    original_price DECIMAL(10, 2),
    sale_price DECIMAL(10, 2) NOT NULL,
    review_score NUMERIC(3, 2),
    review_count INTEGER DEFAULT 0,
    affiliate_url TEXT NOT NULL,
    image_url TEXT,
    merchant_id UUID NOT NULL,
    category_id UUID NOT NULL,
    is_active BOOLEAN NOT NULL DEFAULT true,
    deals_expires_at TIMESTAMP WITH TIME ZONE,
    created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,
    CONSTRAINT fk_merchant FOREIGN KEY (merchant_id) REFERENCES merchants(id) ON DELETE RESTRICT,
    CONSTRAINT fk_category FOREIGN KEY (category_id) REFERENCES categories(id) ON DELETE RESTRICT,
    CONSTRAINT chk_price_positive CHECK (sale_price > 0)
);

CREATE TRIGGER set_products_timestamp
BEFORE UPDATE ON products
FOR EACH ROW EXECUTE FUNCTION update_timestamp();

CREATE INDEX IF NOT EXISTS idx_products_merchant_id ON products(merchant_id);
CREATE INDEX IF NOT EXISTS idx_products_category_id ON products(category_id);
CREATE INDEX IF NOT EXISTS idx_products_product_unique_id ON products(product_unique_id);
CREATE INDEX IF NOT EXISTS idx_products_is_active ON products(is_active);
CREATE INDEX IF NOT EXISTS idx_products_deals_expires ON products(deals_expires_at);

-- ================================================================
-- TABLE: sales_events
-- ================================================================
CREATE TABLE IF NOT EXISTS sales_events (
    id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
    name VARCHAR(255) NOT NULL,
    description TEXT,
    start_date TIMESTAMP WITH TIME ZONE NOT NULL,
    end_date TIMESTAMP WITH TIME ZONE NOT NULL,
    banner_url VARCHAR(2048),
    merchant_id UUID,
    created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,
    CONSTRAINT fk_sales_merchant FOREIGN KEY (merchant_id) REFERENCES merchants(id) ON DELETE SET NULL,
    CONSTRAINT chk_date_order CHECK (start_date < end_date)
);

CREATE TRIGGER set_sales_events_timestamp
BEFORE UPDATE ON sales_events
FOR EACH ROW EXECUTE FUNCTION update_timestamp();

CREATE INDEX IF NOT EXISTS idx_sales_events_merchant_id ON sales_events(merchant_id);
CREATE INDEX IF NOT EXISTS idx_sales_events_dates ON sales_events(start_date, end_date);

-- ================================================================
-- TABLE: product_sales_events (junction)
-- ================================================================
CREATE TABLE IF NOT EXISTS product_sales_events (
    product_id UUID NOT NULL,
    sales_event_id UUID NOT NULL,
    PRIMARY KEY (product_id, sales_event_id),
    CONSTRAINT fk_pse_product FOREIGN KEY (product_id) REFERENCES products(id) ON DELETE CASCADE,
    CONSTRAINT fk_pse_sales_event FOREIGN KEY (sales_event_id) REFERENCES sales_events(id) ON DELETE CASCADE
);

CREATE INDEX IF NOT EXISTS idx_product_sales_events_product ON product_sales_events(product_id);
CREATE INDEX IF NOT EXISTS idx_product_sales_events_event ON product_sales_events(sales_event_id);

-- ================================================================
-- TABLE: coupons
-- ================================================================
CREATE TABLE IF NOT EXISTS coupons (
    id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
    code VARCHAR(100) NOT NULL,
    description TEXT,
    discount_type VARCHAR(20) CHECK (discount_type IN ('PERCENT', 'FLAT')),
    discount_value DECIMAL(10, 2),
    expiry_at TIMESTAMP WITH TIME ZONE,
    merchant_id UUID,
    is_active BOOLEAN DEFAULT true,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    CONSTRAINT fk_coupon_merchant FOREIGN KEY (merchant_id) REFERENCES merchants(id) ON DELETE SET NULL
);

CREATE TRIGGER set_coupons_timestamp
BEFORE UPDATE ON coupons
FOR EACH ROW EXECUTE FUNCTION update_timestamp();

CREATE INDEX IF NOT EXISTS idx_coupons_merchant_id ON coupons(merchant_id);
CREATE INDEX IF NOT EXISTS idx_coupons_expiry ON coupons(expiry_at);
CREATE INDEX IF NOT EXISTS idx_coupons_is_active ON coupons(is_active);

-- ================================================================
-- TABLE: affiliate_clicks
-- ================================================================
CREATE TABLE IF NOT EXISTS affiliate_clicks (
    id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
    user_id UUID,
    product_id UUID NOT NULL,
    merchant_id UUID,
    clicked_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    device_info TEXT,
    ip_address VARCHAR(50),
    CONSTRAINT fk_click_user FOREIGN KEY (user_id) REFERENCES user_login(id) ON DELETE SET NULL,
    CONSTRAINT fk_click_product FOREIGN KEY (product_id) REFERENCES products(id) ON DELETE CASCADE
);

CREATE INDEX IF NOT EXISTS idx_affiliate_clicks_user ON affiliate_clicks(user_id);
CREATE INDEX IF NOT EXISTS idx_affiliate_clicks_product ON affiliate_clicks(product_id);
CREATE INDEX IF NOT EXISTS idx_affiliate_clicks_clicked_at ON affiliate_clicks(clicked_at);

-- ================================================================
-- TABLE: user_wishlist
-- ================================================================
CREATE TABLE IF NOT EXISTS user_wishlist (
    user_id UUID NOT NULL,
    product_id UUID NOT NULL,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    PRIMARY KEY (user_id, product_id),
    CONSTRAINT fk_wishlist_user FOREIGN KEY (user_id) REFERENCES user_login(id) ON DELETE CASCADE,
    CONSTRAINT fk_wishlist_product FOREIGN KEY (product_id) REFERENCES products(id) ON DELETE CASCADE
);

CREATE INDEX IF NOT EXISTS idx_user_wishlist_user ON user_wishlist(user_id);
CREATE INDEX IF NOT EXISTS idx_user_wishlist_product ON user_wishlist(product_id);

-- ================================================================
-- TABLE: user_budgets
-- ================================================================
CREATE TABLE IF NOT EXISTS user_budgets (
    id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
    user_id UUID NOT NULL,
    product_name VARCHAR(255),
    target_price DECIMAL(10, 2),
    current_price DECIMAL(10, 2),
    alert_enabled BOOLEAN DEFAULT true,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    CONSTRAINT fk_budget_user FOREIGN KEY (user_id) REFERENCES user_login(id) ON DELETE CASCADE
);

CREATE INDEX IF NOT EXISTS idx_user_budgets_user ON user_budgets(user_id);

-- ================================================================
-- TABLE: product_price_history
-- ================================================================
CREATE TABLE IF NOT EXISTS product_price_history (
    id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
    product_id UUID NOT NULL,
    price DECIMAL(10, 2),
    recorded_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    CONSTRAINT fk_pph_product FOREIGN KEY (product_id) REFERENCES products(id) ON DELETE CASCADE
);

CREATE INDEX IF NOT EXISTS idx_pph_product_id ON product_price_history(product_id);
CREATE INDEX IF NOT EXISTS idx_pph_recorded_at ON product_price_history(recorded_at DESC);

-- ================================================================
-- TABLE: notifications
-- ================================================================
CREATE TABLE IF NOT EXISTS notifications (
    id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
    user_id UUID,
    message TEXT,
    is_read BOOLEAN DEFAULT false,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    CONSTRAINT fk_notification_user FOREIGN KEY (user_id) REFERENCES user_login(id) ON DELETE CASCADE
);

CREATE INDEX IF NOT EXISTS idx_notifications_user ON notifications(user_id);
CREATE INDEX IF NOT EXISTS idx_notifications_is_read ON notifications(is_read);
CREATE INDEX IF NOT EXISTS idx_notifications_created_at ON notifications(created_at DESC);

