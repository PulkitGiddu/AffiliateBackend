<?xml version="1.0" encoding="utf-8"?>
<!-- Matches Flutter splash gradient so no white flash before splash -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="135"
        android:startColor="#2874F0"
        android:centerColor="#1E88E5"
        android:endColor="#1565C0"
        android:type="linear" />
</shape>
